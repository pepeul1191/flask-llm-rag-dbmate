#!/usr/bin/env python3
"""
run_error_detection.py
======================
Inyecta errores estructurales conocidos en cada schema PUML y mide
TP/FN/FP del validador. Responde al Reviewer 1:

  "report false positives and false negatives using migrations with known errors"

Salidas (en ./reports/):
  error_detection.json — datos crudos + tabla por schema
  error_detection.md   — tabla Markdown lista para copiar
  error_detection.tex  — tabla LaTeX lista para el paper

Uso:
    python run_error_detection.py
"""
import json
import os
from ai.pipeline.runner import resolve_input_to_folder
from ai.pipeline.tests_api import run_structural_validation_tests

# ------------------------------------------------------------------ #
# Configuración
# ------------------------------------------------------------------ #
SCHEMAS = [
    "basico",
    "biblio",
    "innova",
    "northwind",
    "postulaciones",
]
ERROR_TYPES = [
    "drop_table",
    "drop_column",
    "change_type",
    "drop_pk",
    "drop_fk",
    "rename_table",
]
DB_TYPE = "sqlite"
OUT_DIR = "reports"
PIPELINE_OUT = "./tmp/pipeline_results"

SHORT = {
    "drop_table":   "dTable",
    "drop_column":  "dCol",
    "change_type":  "cType",
    "drop_pk":      "dPK",
    "drop_fk":      "dFK",
    "rename_table": "rTable",
}


def _rate(tp: int, fn: int):
    total = tp + fn
    return round(tp / total, 4) if total else None


def _fmt(x, nd=3, na="—"):
    return na if x is None else f"{x:.{nd}f}"


# ------------------------------------------------------------------ #
# Bucle principal
# ------------------------------------------------------------------ #
def main():
    os.makedirs(OUT_DIR, exist_ok=True)

    table = {}
    raw = {}

    for schema in SCHEMAS:
        src = f"schemas/{schema}.puml"
        if not os.path.exists(src):
            print(f"[{schema:15s}] SKIP (no existe {src})")
            table[schema] = {"error": "missing_puml"}
            continue

        try:
            with resolve_input_to_folder(src) as folder:
                result = run_structural_validation_tests(
                    folder_path=folder,
                    db_type=DB_TYPE,
                    include_clean_baseline=True,
                    output_dir=PIPELINE_OUT,
                    write_summary=False,
                )
            raw[schema] = result

            row = {}
            for etype in ERROR_TYPES:
                v = result["per_error_type"].get(etype, {})
                row[etype] = _rate(v.get("TP", 0), v.get("FN", 0))

            clean = result["per_error_type"].get("clean", {})
            row["clean_FP"] = clean.get("FP", 0)
            row["aggregate"] = result["aggregate"]
            table[schema] = row

            a = result["aggregate"]
            print(
                f"[{schema:15s}] P={a['precision']:.3f}  "
                f"R={a['recall']:.3f}  F1={a['f1']:.3f}  "
                f"FP(clean)={row['clean_FP']}"
            )
        except Exception as e:
            print(f"[{schema:15s}] FAIL: {e}")
            table[schema] = {"error": str(e)}

    # ---------------------------------------------------------------- #
    # JSON
    # ---------------------------------------------------------------- #
    json_path = os.path.join(OUT_DIR, "error_detection.json")
    with open(json_path, "w", encoding="utf-8") as f:
        json.dump({"per_schema": table, "raw": raw}, f, indent=2,
                  ensure_ascii=False)
    print(f"\n[OK] JSON  -> {json_path}")

    # ---------------------------------------------------------------- #
    # Markdown
    # ---------------------------------------------------------------- #
    md_path = os.path.join(OUT_DIR, "error_detection.md")
    with open(md_path, "w", encoding="utf-8") as f:
        f.write("# Detección de errores estructurales inyectados\n\n")
        f.write(f"DB tipo: `{DB_TYPE}`. Cada celda = TP/(TP+FN) por tipo "
                f"de error. `FP(clean)` = falsos positivos sobre el baseline "
                f"sin errores (0 es lo ideal).\n\n")
        hdr = ["Schema"] + [SHORT[e] for e in ERROR_TYPES] + \
              ["FP(clean)", "P", "R", "F1"]
        f.write("| " + " | ".join(hdr) + " |\n")
        f.write("|" + "---|" * len(hdr) + "\n")
        for schema, row in table.items():
            if "error" in row:
                f.write(f"| {schema} | " + "— |" * (len(hdr) - 1) + " err |\n")
                continue
            a = row["aggregate"]
            cells = [schema]
            for e in ERROR_TYPES:
                cells.append(_fmt(row.get(e)))
            cells += [str(row["clean_FP"]),
                      _fmt(a["precision"]),
                      _fmt(a["recall"]),
                      _fmt(a["f1"])]
            f.write("| " + " | ".join(cells) + " |\n")
    print(f"[OK] MD    -> {md_path}")

    # ---------------------------------------------------------------- #
    # LaTeX
    # ---------------------------------------------------------------- #
    tex_path = os.path.join(OUT_DIR, "error_detection.tex")
    with open(tex_path, "w", encoding="utf-8") as f:
        f.write("% Auto-generated by run_error_detection.py\n")
        f.write("\\begin{table}[h]\n\\centering\n")
        f.write("\\caption{Detección de errores estructurales inyectados "
                "(TP/(TP+FN) por tipo)}\n")
        f.write("\\label{tab:error-detection}\n")
        f.write("\\begin{tabular}{l " + "c" * len(ERROR_TYPES) +
                " c ccc}\n\\hline\n")
        f.write("Schema & " +
                " & ".join(SHORT[e] for e in ERROR_TYPES) +
                " & FP & P & R & F1 \\\\\n\\hline\n")
        for schema, row in table.items():
            if "error" in row:
                f.write(f"{schema} & " + "--- & " * (len(ERROR_TYPES) + 3) +
                        "err \\\\\n")
                continue
            a = row["aggregate"]
            cells = [schema]
            for e in ERROR_TYPES:
                v = row.get(e)
                cells.append("---" if v is None else f"{v:.2f}")
            cells += [str(row["clean_FP"]),
                      f"{a['precision']:.2f}",
                      f"{a['recall']:.2f}",
                      f"{a['f1']:.2f}"]
            f.write(" & ".join(cells) + " \\\\\n")
        f.write("\\hline\n\\end{tabular}\n\\end{table}\n")
    print(f"[OK] TEX   -> {tex_path}")


if __name__ == "__main__":
    main()