@startuml
!theme plain

entity customers {
  * customer_id : INTEGER
  --
  * company_name : VARCHAR(40)
  * contact_name : VARCHAR(30)
  * contact_title : VARCHAR(30)
  * address : VARCHAR(60)
  * city : VARCHAR(15)
  region : VARCHAR(15)
  postal_code : VARCHAR(10)
  country : VARCHAR(15)
  phone : VARCHAR(24)
  fax : VARCHAR(24)
}

entity employees {
  * employee_id : INTEGER
  --
  * last_name : VARCHAR(20)
  * first_name : VARCHAR(10)
  * title : VARCHAR(30)
  * title_of_courtesy : VARCHAR(25)
  * birth_date : DATE
  * hire_date : DATE
  * address : VARCHAR(60)
  * city : VARCHAR(15)
  region : VARCHAR(15)
  postal_code : VARCHAR(10)
  country : VARCHAR(15)
  home_phone : VARCHAR(24)
  extension : VARCHAR(4)
  notes : TEXT
  reports_to : INTEGER
}

entity suppliers {
  * supplier_id : INTEGER
  --
  * company_name : VARCHAR(40)
  * contact_name : VARCHAR(30)
  * contact_title : VARCHAR(30)
  * address : VARCHAR(60)
  * city : VARCHAR(15)
  region : VARCHAR(15)
  postal_code : VARCHAR(10)
  country : VARCHAR(15)
  phone : VARCHAR(24)
  fax : VARCHAR(24)
  homepage : TEXT
}

entity categories {
  * category_id : INTEGER
  --
  * category_name : VARCHAR(15)
  description : TEXT
  picture : BLOB
}

entity products {
  * product_id : INTEGER
  --
  * product_name : VARCHAR(40)
  supplier_id : INTEGER
  category_id : INTEGER
  quantity_per_unit : VARCHAR(20)
  unit_price : DECIMAL
  units_in_stock : INTEGER
  units_on_order : INTEGER
  reorder_level : INTEGER
  discontinued : BOOLEAN
}

entity shippers {
  * shipper_id : INTEGER
  --
  * company_name : VARCHAR(40)
  * phone : VARCHAR(24)
}

entity orders {
  * order_id : INTEGER
  --
  customer_id : INTEGER
  employee_id : INTEGER
  shipper_id: INTEGER
  order_date : DATETIME
  required_date : DATETIME
  shipped_date : DATETIME
  ship_via : INTEGER
  freight : DECIMAL
  ship_name : VARCHAR(40)
  ship_address : VARCHAR(60)
  ship_city : VARCHAR(15)
  ship_region : VARCHAR(15)
  ship_postal_code : VARCHAR(10)
  ship_country : VARCHAR(15)
}

entity order_details {
  * order_id : INTEGER
  * product_id : INTEGER
  --
  unit_price : DECIMAL
  quantity : SMALLINT
  discount : FLOAT
}

' Relaciones

customers }|--|| orders : customer_id
employees }|--|| orders : employee_id
employees }|--|| employees : reports_to

suppliers }|--|| products : supplier_id
categories }|--|| products : category_id

shippers }|--|| orders : ship_via

orders }|--|| order_details : order_id
products }|--|| order_details : product_id

@enduml