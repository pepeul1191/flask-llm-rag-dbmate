@startuml
!theme plain

entity customers {
  * id : INTEGER
  --
  company_name : VARCHAR(40)
  contact_name : VARCHAR(30)
  contact_title : VARCHAR(30)
  address : VARCHAR(60)
  city : VARCHAR(15)
  region : VARCHAR(15)
  postal_code : VARCHAR(10)
  country : VARCHAR(15)
  phone : VARCHAR(24)
  fax : VARCHAR(24)
}

entity employees {
  * id : INTEGER
  --
  last_name : VARCHAR(20)
  first_name : VARCHAR(10)
  title : VARCHAR(30)
  title_of_courtesy : VARCHAR(25)
  birth_date : DATE
  hire_date : DATE
  address : VARCHAR(60)
  city : VARCHAR(15)
  region : VARCHAR(15)
  postal_code : VARCHAR(10)
  country : VARCHAR(15)
  home_phone : VARCHAR(24)
  extension : VARCHAR(4)
  notes : TEXT
  reports_to_id : INTEGER
}

entity suppliers {
  * id : INTEGER
  --
  company_name : VARCHAR(40)
  contact_name : VARCHAR(30)
  contact_title : VARCHAR(30)
  address : VARCHAR(60)
  city : VARCHAR(15)
  region : VARCHAR(15)
  postal_code : VARCHAR(10)
  country : VARCHAR(15)
  phone : VARCHAR(24)
  fax : VARCHAR(24)
  homepage : TEXT
}

entity categories {
  * id : INTEGER
  --
  category_name : VARCHAR(15)
  description : TEXT
  picture : BLOB
}

entity products {
  * id : INTEGER
  --
  product_name : VARCHAR(40)
  supplier_id : INTEGER
  category_id : INTEGER
  quantity_per_unit : VARCHAR(20)
  unit_price : DECIMAL
  units_in_stock : INTEGER
  units_on_order : INTEGER
  reorder_level : INTEGER
  discontinued : BOOLEAN
}

entity shippers {
  * id : INTEGER
  --
  company_name : VARCHAR(40)
  phone : VARCHAR(24)
}

entity orders {
  * id : INTEGER
  --
  customer_id : INTEGER
  employee_id : INTEGER
  shipper_id : INTEGER
  order_date : DATETIME
  required_date : DATETIME
  shipped_date : DATETIME
  freight : DECIMAL
  ship_name : VARCHAR(40)
  ship_address : VARCHAR(60)
  ship_city : VARCHAR(15)
  ship_region : VARCHAR(15)
  ship_postal_code : VARCHAR(10)
  ship_country : VARCHAR(15)
}

entity order_details {
  * id : INTEGER
  --
  order_id : INTEGER
  product_id : INTEGER
  unit_price : DECIMAL
  quantity : SMALLINT
  discount : FLOAT
}

' =============================================
' Relaciones — Rails notation
' Patrón: `parent ||--o{ child : fk_column`
' =============================================

customers  ||--o{ orders        : customer_id
employees  ||--o{ orders        : employee_id
employees  ||--o{ employees     : reports_to_id
shippers   ||--o{ orders        : shipper_id

suppliers  ||--o{ products      : supplier_id
categories ||--o{ products      : category_id

orders     ||--o{ order_details : order_id
products   ||--o{ order_details : product_id

@enduml